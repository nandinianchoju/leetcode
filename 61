class Solution:
    def rotateRight(self, head, k):
        if not head or not head.next or k == 0:
            return head
        
        # Step 1: Find length
        length = 1
        tail = head
        while tail.next:
            tail = tail.next
            length += 1
        
        # Step 2: Make it circular
        tail.next = head
        
        # Step 3: Reduce k
        k = k % length
        
        # Step 4: Find new tail
        steps = length - k
        new_tail = head
        for _ in range(steps - 1):
            new_tail = new_tail.next
        
        # Step 5: Set new head
        new_head = new_tail.next
        
        # Step 6: Break the circle
        new_tail.next = None
        
        return new_head
