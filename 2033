class Solution:
    def minOperations(self, grid: List[List[int]], x: int) -> int:
        arr = []
        
        # Flatten grid
        for row in grid:
            for num in row:
                arr.append(num)
        
        # Check feasibility
        rem = arr[0] % x
        for num in arr:
            if num % x != rem:
                return -1
        
        # Sort and find median
        arr.sort()
        median = arr[len(arr) // 2]
        
        # Count operations
        ops = 0
        for num in arr:
            ops += abs(num - median) // x
        
        return ops
